{
  "name": "abdullahdewan",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:check": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lighthouse": "lighthouse http://localhost:3000 --view --preset=desktop --output-path=./reports/lighthouse-desktop.html --chrome-flags='--headless'",
    "lighthouse:mobile": "lighthouse http://localhost:3000 --view --preset=all --output-path=./reports/lighthouse-mobile.html --chrome-flags='--headless'",
    "lighthouse:ci": "lighthouse http://localhost:3000 --output json --output-path=./reports/lighthouse-report.json --chrome-flags='--headless'",
    "test": "vitest run"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.2",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/turnstile": "^1.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "nuxt": "^4.6.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12"
  },
  "overrides": {
    "@simple-git/argv-parser": "^2.0.1",
    "decode-uri-component": "^0.5.0"
  }
